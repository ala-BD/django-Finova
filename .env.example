SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/finova
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
REDIS_URL=redis://localhost:6379/0
# Le backend console affiche les e-mails dans le terminal et ne les envoie pas.
# Pour envoyer de vrais e-mails, utiliser django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Finova <noreply@finova.app>
# URL publique de l'application pour les liens d'invitation (laisser vide en local)
PUBLIC_BASE_URL=
DJANGO_SETTINGS_MODULE=config.settings.dev
